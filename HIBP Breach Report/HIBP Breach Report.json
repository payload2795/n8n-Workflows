    {
      "parameters": {
        "jsCode": "// Alle neuen Breaches einsammeln\nconst breaches = $input.all().map(item => item.json);\n\n// HTML-Escaping gegen fehlerhafte HTML-Ausgabe\nfunction escapeHtml(value) {\n  return String(value ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n}\n\nfunction formatDescription(value) {\n  if (!value) return '';\n\n  return String(value)\n    // Markdown-Links in HTML-Links umwandeln\n    .replace(\n      /\\[([^\\]]+)\\]\\((https?:\\/\\/[^)\\s]+)\\)/g,\n      '<a href=\"$2\" target=\"_blank\" rel=\"noopener\">$1</a>'\n    )\n    // Markdown-Formatierungsreste entfernen\n    .replace(/\\\\</g, '<')\n    .replace(/\\\\>/g, '>')\n    .replace(/\\\\_/g, '_')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&amp;/g, '&')\n    // Zeilenumbrüche\n    .replace(/\\n/g, '<br>');\n}\n\n// Zahlen formatieren\nfunction formatNumber(value) {\n  return Number(value || 0).toLocaleString('de-DE');\n}\n\n// HTML für jeden Breach erzeugen\nconst breachHtml = breaches.map(b => `\n  <div style=\"border:1px solid #ddd; border-radius:8px;\n              padding:16px; margin-bottom:16px;\">\n\n    <h2 style=\"margin-top:0; color:#c0392b;\">\n      ${escapeHtml(b.Title || b.Name)}\n    </h2>\n\n    <p><strong>Domain:</strong> ${escapeHtml(b.Domain || '-')}</p>\n    <p><strong>Vorfallsdatum:</strong> ${escapeHtml(b.BreachDate || '-')}</p>\n    <p><strong>Veröffentlicht:</strong> ${escapeHtml(b.AddedDate || '-')}</p>\n    <p><strong>Betroffene Accounts:</strong>\n       ${formatNumber(b.PwnCount)}</p>\n\n    <p><strong>Kompromittierte Daten:</strong><br>\n       ${escapeHtml((b.DataClasses || []).join(', '))}</p>\n\n    <div style=\"line-height:1.6; margin-top:12px;\">\n    ${formatDescription(b.Description)}\n    </div>\n  </div>\n`).join('');\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<body style=\"font-family:Arial,sans-serif; color:#333;\n             max-width:800px; margin:auto;\">\n\n  <div style=\"background:#202b38; color:white; padding:24px;\">\n    <h1 style=\"margin:0;\">HIBP Security Report</h1>\n    <p>Neue Data Breaches erkannt</p>\n  </div>\n\n  <div style=\"padding:24px;\">\n    <h2>${breaches.length} neue Breaches gefunden</h2>\n\n    <p>Der HIBP-Katalog enthält neue Sicherheitsvorfälle,\n       die bisher nicht in unserem Monitoring erfasst waren.</p>\n\n    ${breachHtml}\n\n    <hr>\n    <p style=\"font-size:12px; color:#777;\">\n      Automatisch generierter Bericht durch n8n.<br>\n      Quelle: Have I Been Pwned\n    </p>\n  </div>\n\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    subject: `HIBP Security Alert: ${breaches.length} neue Breaches`,\n    html,\n    breachCount: breaches.length,\n    breaches\n  }\n}];"
      },
