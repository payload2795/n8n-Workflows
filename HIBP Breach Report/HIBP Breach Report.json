    {
      "parameters": {
        "jsCode": "// HIBP-Katalog\nconst allBreaches = $('Get Breaches')\n  .all()\n  .map(item => item.json);\n\n// Bereits gespeicherte Breaches\nconst knownItems = $('Get Known Breaches')\n  .all()\n  .filter(item => item.json.name);\n\nconst knownNames = new Set(\n  knownItems.map(item => item.json.name)\n);\n\n// Erstinitialisierung\nconst firstRun = knownItems.length === 0;\n\n// Alle Breaches einzeln ausgeben\nreturn allBreaches.map(breach => ({\n  json: {\n    Name: breach.Name,\n    Title: breach.Title,\n    Domain: breach.Domain,\n    BreachDate: breach.BreachDate,\n    AddedDate: breach.AddedDate,\n    PwnCount: breach.PwnCount,\n    DataClasses: breach.DataClasses,\n    Description: breach.Description,\n\n    firstRun,\n    isKnown: knownNames.has(breach.Name),\n    isNew: !knownNames.has(breach.Name)\n  }\n}));"
      },
